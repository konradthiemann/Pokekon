{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @pokekon/shared && npm run build -w @pokekon/api"
  },
  "deploy": {
    "startCommand": "npm run job:scheduled -w @pokekon/api",
    "cronSchedule": "0 6 * * *",
    "restartPolicyType": "NEVER"
  }
}
