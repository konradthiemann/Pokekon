{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @pokekon/shared && npm run build -w @pokekon/web && npm run build -w @pokekon/api"
  },
  "deploy": {
    "preDeployCommand": "npm run migrate:deploy -w @pokekon/api",
    "startCommand": "npm run start -w @pokekon/api",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
