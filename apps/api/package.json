{
  "name": "@pokekon/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate:deploy": "node dist/migrate.js",
    "job:sync-meta": "node dist/jobs/syncMeta.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.16",
    "@hono/node-server": "^2.0.10",
    "@pokekon/shared": "*",
    "better-auth": "^1.6.16",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "pg": "^8.21.0",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.8"
  }
}
