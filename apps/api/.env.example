# HTTP port the server listens on (Railway injects PORT automatically).
PORT=8080

# Postgres connection string (Railway: use the DATABASE_URL reference variable).
# Required for /api/auth/* and migrations; /health works without it.
DATABASE_URL=postgres://user:password@localhost:5432/pokekon

# Better Auth signing secret — generate with: openssl rand -base64 32
# Required in production (NODE_ENV=production).
BETTER_AUTH_SECRET=

# Public base URL of this API (used for auth callbacks/redirects).
# Local default works without it; set in production, e.g. https://api.example.com
BETTER_AUTH_URL=http://localhost:8080

# Browser origin allowed for CORS with credentials (the web app).
WEB_ORIGIN=http://localhost:5173

# Google OAuth (optional). The Google provider is only enabled when BOTH are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
